  <experiments>
    <experiment name="headless-check" repetitions="1" sequentialRunOrder="true" runMetricsEveryStep="true" timeLimit="10">
      <setup>setup</setup>
      <go>go</go>
      <metrics>
        <metric>item 0 attendance</metric>
        <metric>item 1 attendance</metric>
        <metric>item 2 attendance</metric>
        <metric>capacity</metric>
        <metric>mean-p-go</metric>
        <metric>fraction-out</metric>
        <metric>night-ms</metric>
        <metric>night-cost</metric>
        <metric>total-cost</metric>
        <metric>failed-calls</metric>
      </metrics>
      <constants>
        <enumeratedValueSet variable="backend">
          <value value="&quot;typesafe (Jev)&quot;"/>
        </enumeratedValueSet>
        <enumeratedValueSet variable="decision-rule">
          <value value="&quot;sample from probabilities&quot;"/>
          <value value="&quot;always take the top pick&quot;"/>
        </enumeratedValueSet>
        <enumeratedValueSet variable="num-patrons">
          <value value="150"/>
        </enumeratedValueSet>
        <enumeratedValueSet variable="capacity-percent">
          <value value="60"/>
        </enumeratedValueSet>
        <enumeratedValueSet variable="num-bars">
          <value value="3"/>
        </enumeratedValueSet>
        <enumeratedValueSet variable="show-observations?">
          <value value="false"/>
        </enumeratedValueSet>
      </constants>
    </experiment>
  </experiments>
</model>
